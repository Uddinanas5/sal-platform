{
  "name": "sal-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/validate-env.mjs",
    "check:launch": "node scripts/launch-safety-check.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:transactions": "node scripts/check-transaction-side-effects.mjs",
    "check:db": "node --env-file=.env scripts/db-health-check.mjs",
    "check:orphans": "node scripts/orphan-sweep.mjs",
    "check:restore": "node scripts/verify-restore.mjs",
    "check:rawsql": "node scripts/check-raw-sql-tenancy.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=America/New_York vitest run",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:fake-success": "node scripts/check-fake-success.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:golden": "tsx scripts/golden-path.mts",
    "trust": "node scripts/trust-report.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:trigger": "stripe trigger",
    "test:e2e": "playwright test",
    "loop:gate": "node loop/gate.mjs",
    "loop:smoke": "node loop/gate.mjs --smoke",
    "loop:gate:db": "node loop/gate.mjs --with-db"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
